{
  "$defs": {
    "ExposureRow": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "content_returned": {
          "default": false,
          "title": "Content Returned",
          "type": "boolean"
        },
        "content_stage": {
          "default": "unknown",
          "title": "Content Stage",
          "type": "string"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "evidence_kind": {
          "default": "unverified",
          "title": "Evidence Kind",
          "type": "string"
        },
        "exposure_state": {
          "title": "Exposure State",
          "type": "string"
        },
        "first_sequence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Sequence"
        },
        "model_received_payload": {
          "default": "unknown",
          "title": "Model Received Payload",
          "type": "string"
        },
        "payload_path": {
          "title": "Payload Path",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "variant_id",
        "payload_path",
        "exposure_state",
        "basis"
      ],
      "title": "ExposureRow",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "produced_at": {
      "title": "Produced At",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ExposureRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "default": "unknown",
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Summary",
      "type": "object"
    },
    "task_id": {
      "default": "",
      "title": "Task Id",
      "type": "string"
    }
  },
  "title": "ExposureReport",
  "type": "object"
}
